# Copy to .env. Replace every CHANGE_ME value before starting the stack.
CITADEL_PORT=8000
CITADEL_GENERATION_ID=CHANGE_ME_GENERATION
CITADEL_ADMIN_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
QDRANT_API_KEY=CHANGE_ME_WITH_A_RANDOM_QDRANT_KEY
LLM_API_KEY=CHANGE_ME_WITH_YOUR_OPENROUTER_KEY

# Optional provider overrides.
LLM_PROVIDER=custom
LLM_MODEL=openrouter/deepseek/deepseek-v4-flash
LLM_ENDPOINT=https://openrouter.ai/api/v1
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
